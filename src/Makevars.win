CXX_STD = CXX17

# Source files and native optimization for local Rtools builds
OBJECTS = RcppExports.o accession_import.o count.o demultiplex.o denoise.o fastq_profile.o pairend.o reorder_fastq.o seq_compare.o unique.o utils.o

# Package features and libraries
PKG_CPPFLAGS = -DUSE_RCPP_OUTPUT
PKG_CXXFLAGS = $(METAEDNA_NATIVE_FLAGS) $(SHLIB_OPENMP_CXXFLAGS)
PKG_LIBS = -lz $(SHLIB_OPENMP_CXXFLAGS)
